# ─── Core ────────────────────────────────────────────────────────────────────

# Port exposed on the host. 18081 is gecko-notes and 18082 is GAM, so GVC takes 18083.
APP_PORT=18083

# REQUIRED. This MUST be the same value gecko-notes uses: GVC issues no tokens of its
# own — it verifies the ones Notes signs. Login is GVC's one runtime dependency on Notes.
JWT_SECRET_KEY=

# Exact origins allowed to call the API cross-origin. Production needs nothing here
# (nginx serves both halves as one origin). Development does, because the Vite origin
# differs from uvicorn's and a cookie-authenticated write is refused without it:
#   CORS_ORIGIN=http://localhost:5175
CORS_ORIGIN=

# Where an unauthenticated visitor is sent to sign in. Served to the browser at runtime
# over /api/config, and the frontend container's CSP connect-src, so one setting.
NOTES_BASE_URL=https://notes.geckopico.com

# The media library. GVC's server searches it and uploads to it as the signed-in user,
# and the browser loads thumbnails and previews from it (the CSP's img-src/media-src).
# GAM must share JWT_SECRET_KEY with Notes and GVC, or it refuses the forwarded session.
#
# In development: GAM_BASE_URL=http://localhost:8001 and NOTES_BASE_URL=http://localhost:8000.
# The dev user (DEV_AUTH_USER) sends no token, so GAM must run with a dev user too.
GAM_BASE_URL=https://assets.geckopico.com

# Per-request timeout for GAM, in seconds.
GAM_TIMEOUT_SECONDS=30

# The largest file "Copy into GAM" will move out of a note pushed from Notes, in MB.
NOTE_MEDIA_MAX_MB=4096

# ─── Rendering ───────────────────────────────────────────────────────────────
#
# Narration is read through Gecko Notes (NOTES_BASE_URL) as the signed-in user, so
# voices and speech keys stay in Notes' settings. That needs a Notes with
# gecko-notes#211; an older one makes a render stop and say so.

# Renders running at once. Encoding is CPU-bound and shares the box with Notes and GAM.
RENDER_CONCURRENCY=1
RENDER_MAX_SEGMENTS=200
RENDER_MAX_NARRATION_CHARS=60000
# GAM files fetched for rendering are cached under data/cache/media, pruned to this.
RENDER_CACHE_MAX_GB=20
# The largest single GAM file a render will fetch, in MB. Raise it for long raw
# footage, and keep RENDER_CACHE_MAX_GB above the total of the files one video uses:
# the cache is pruned after fetching and before encoding.
RENDER_MAX_FILE_MB=8192
# Keep each render's working files under data/work/ for debugging. Gigabytes a render.
RENDER_KEEP_WORK=false
# ffmpeg's log level for render steps. "info" or "verbose" also log what ffmpeg says
# on steps that succeed (docker compose logs gvc-backend), for chasing a render that
# finished but came out wrong.
RENDER_FFMPEG_LOGLEVEL=error
# How long the link to a finished render stays valid, in seconds.
MEDIA_URL_TTL_SECONDS=3600

# ─── Administrators ──────────────────────────────────────────────────────────

# Gecko Notes user ids or usernames, comma-separated, matched exactly. Nothing in GVC
# is admin-only yet.
ADMIN_USERS=

# ─── Development only ────────────────────────────────────────────────────────

# "development" enables DEV_AUTH_USER below. Anything else, and it is ignored.
ENVIRONMENT=production

# Accept unauthenticated requests as this user id, for running GVC without Notes.
# Requires ENVIRONMENT=development as well.
DEV_AUTH_USER=

# ─── Reverse proxy ───────────────────────────────────────────────────────────

# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
