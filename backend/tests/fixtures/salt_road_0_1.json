      "narration": {
        "beats": [
          {
            "id": "b1",
            "text": "Caravans thousands of camels long made the crossing every year."
          },
          {
            "id": "b2",
            "kind": "quote",
            "text": "Salt was worth its weight in gold, and the desert knew it."
          },
          {
            "id": "b3",
            "text": "The journey took weeks... if the wells held."
          }
        ]
